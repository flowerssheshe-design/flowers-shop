# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override; falls back to site_config.admin_pin server-side
ADMIN_PIN=

# WhatsApp / Payment display (numbers shown to customers)
NEXT_PUBLIC_WHATSAPP_NUMBER=9720500000000
NEXT_PUBLIC_DELIVERY_FEE=15
NEXT_PUBLIC_BIT_NUMBER=0500000000
NEXT_PUBLIC_PAYBOX_NUMBER=0500000000

# WhatsApp Business Cloud API — used by the admin "Send WhatsApp" dashboard to
# deliver messages to customers automatically. Leave empty to disable sending.
# See https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v18.0
# Public flag for the admin UI banner — set to "1" when token+phone are configured.
NEXT_PUBLIC_WHATSAPP_CONFIGURED=0

# Club member discount settings
NEXT_PUBLIC_CLUB_DISCOUNT_THRESHOLD=3
NEXT_PUBLIC_MEMBER_DISCOUNT_PERCENT=10